 // Live UI updates must not strand keyboard focus on a detached button.
+// Preserve the visible control's position when content above it grows or its
+// Wisp changes groups. A fixed scrollTop would move it with that content.
+function captureControlViewport(root){
+  var focused=document.activeElement;
+  if(!root || !focused || !root.contains(focused)) return null;
+  var main=document.querySelector('main');
+  if(!main) return null;
+  var rect=focused.getBoundingClientRect(),view=main.getBoundingClientRect();
+  if(!rect.width || !rect.height || rect.bottom<=view.top || rect.top>=view.bottom) return null;
+  return {root:root,main:main,top:rect.top};
+}
+function restoreControlViewport(snapshot){
+  if(!snapshot) return;
+  var focused=document.activeElement;
+  if(!focused || !snapshot.root.contains(focused)) return;
+  var rect=focused.getBoundingClientRect();
+  if(!rect.width || !rect.height) return;
+  // Measuring flushes layout and any browser anchoring before the correction.
+  snapshot.main.scrollTop+=rect.top-snapshot.top;
+}
